{
  "name": "phieu-ket-qua",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute phieu-ket-qua --local --file=schema.sql",
    "db:remote": "wrangler d1 execute phieu-ket-qua --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "don:staging": "wrangler d1 execute phieu-ket-qua-staging --env staging --remote --file=scripts/don-du-lieu-thu.sql",
    "db:staging": "wrangler d1 execute phieu-ket-qua-staging --env staging --remote --file=schema.sql",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "sql.js": "1.10.3",
    "wrangler": "^4.20.0",
    "xlsx": "0.18.5"
  }
}
